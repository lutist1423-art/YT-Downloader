# Copy this file to .env.local (or .env) and fill in the values from your
# deployed infra (see /infra CDK stack outputs).
#
# All variables MUST be prefixed with VITE_ so Vite exposes them to the
# client bundle via import.meta.env. Never put secrets here - this file
# ends up embedded in the client-side JS bundle at build time.

# API Gateway HTTP API base URL, no trailing slash.
# Example: https://abc123xyz.execute-api.eu-central-1.amazonaws.com
VITE_API_URL=https://your-api-id.execute-api.eu-central-1.amazonaws.com

# AWS region the Cognito user pools live in.
VITE_AWS_REGION=eu-central-1

# Regular ("customer") user pool - self-signup enabled, email/password, no MFA.
VITE_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin user pool - no self-signup (admins are created out-of-band by an
# operator via AWS CLI), TOTP MFA mandatory.
VITE_ADMIN_POOL_ID=eu-central-1_YYYYYYYYY
VITE_ADMIN_POOL_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy
